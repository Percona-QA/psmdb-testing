FROM alpine
RUN apk add --no-cache bash krb5 krb5-server \
        python3 py3-pip python3-dev gcc musl-dev krb5-dev \
    && pip3 install --break-system-packages pymongo pykerberos \
    && apk del gcc musl-dev python3-dev krb5-dev \
    && rm -rf /root/.cache
COPY conf/krb5.conf /etc/krb5.conf
RUN adduser -u 1001 -S mongodb && chown -R mongodb /var/lib/krb5kdc
USER 1001
RUN kdb5_util -P password create -s && \
    kadmin.local -q "addprinc -pw password root/admin"
CMD ["/usr/sbin/krb5kdc","-n"]
